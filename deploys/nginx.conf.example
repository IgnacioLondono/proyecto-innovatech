# Ejemplo para EC2-Web (Nginx). Sustituye BACKEND_PRIVATE_IP por la IP privada de EC2-App.
# Rutas públicas /api/ventas y /api/despachos → microservicios en 8082 y 8081.

server {
    listen 80;
    server_name _;
    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ventas {
        rewrite ^/api/ventas(.*)$ /api/v1/ventas$1 break;
        proxy_pass http://BACKEND_PRIVATE_IP:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/despachos {
        rewrite ^/api/despachos(.*)$ /api/v1/despachos$1 break;
        proxy_pass http://BACKEND_PRIVATE_IP:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
